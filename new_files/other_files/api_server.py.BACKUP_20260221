@app.route("/chat", methods=["POST"])
def chat():
    try:
        data = request.get_json(force=True, silent=True) or {}
        message = (data.get("message") or "").strip()
        user_id = (data.get("user_id") or "web_user").strip()

        if not message:
            return jsonify({"error": "메시지가 필요합니다"}), 400

        emotion_result = emotion_engine.analyze_emotion(message)

        if emay_brain:
            try:
                response_text = emay_brain.chat(user_id, message)
            except Exception:
                response_text = "안녕! 나는 Lee May야! 😊 무엇을 도와줄까?"
        else:
            response_text = "안녕! 나는 Lee May야! 😊 무엇을 도와줄까?"

        # ✅ 프론트 호환: reply/response 둘 다 제공
        return jsonify({
            "reply": response_text,
            "response": response_text,
            "emotion": emotion_result.get("emotion", "neutral"),
            "image_url": emotion_result.get("image_path", "/image/neutral"),
            "confidence": emotion_result.get("confidence", 0.0)
        }), 200

    except Exception as e:
        return jsonify({"error": str(e)}), 500

