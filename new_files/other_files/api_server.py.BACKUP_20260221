def _log_ops(msg: str):
    try:
        with open(OPS_LOG, "a", encoding="utf-8") as f:
            f.write(f"[{datetime.now().isoformat()}] {msg}\n")
    except:
        pass

def _load_admin_keys():
    """
    여러 키 소스를 '모두' 유효키로 인정 (env/file 혼재/구버전 키 남아도 해결)
    반환: [{"src": "...", "key": "..."}]
    """
    keys = []

    # 1) env 후보들
    env_names = ["LEEMAY_ADMIN_KEY", "ADMIN_TOKEN", "LEEMAY_ADMIN_TOKEN"]
    for name in env_names:
        v = (os.environ.get(name) or "").strip()
        if v:
            keys.append({"src": f"env:{name}", "key": v})

    # 2) 파일 후보들 (둘 다 인정)
    file_candidates = [
        os.path.join(SECRETS_DIR, "admin_key.txt"),
        os.path.join(SECRETS_DIR, "admin_token.txt"),
        os.path.join(SECRETS_DIR, "LEEMAY_ADMIN_KEY.txt"),
        os.path.join(SECRETS_DIR, "ADMIN_TOKEN.txt"),
    ]
    for p in file_candidates:
        if os.path.exists(p):
            try:
                v = open(p, "r", encoding="utf-8").read().strip()
                if v:
                    keys.append({"src": f"file:{os.path.basename(p)}", "key": v})
            except:
                pass

    # 중복 제거
    uniq = []
    seen = set()
    for item in keys:
        if item["key"] not in seen:
            uniq.append(item)
            seen.add(item["key"])
    return uniq

def _extract_presented_key():
    """
    헤더로 전달된 키를 최대한 넓게 수용
    - X-Admin-Key
    - X-Admin-Token
    - Authorization: Bearer <token>
    """
    got = (request.headers.get("X-Admin-Key") or "").strip()
    if got:
        return got

    got = (request.headers.get("X-Admin-Token") or "").strip()
    if got:
        return got

    auth = (request.headers.get("Authorization") or "").strip()
    if auth.lower().startswith("bearer "):
        return auth.split(" ", 1)[1].strip()

    return ""

def _require_admin():
    keys = _load_admin_keys()
    got = _extract_presented_key()

    if not keys:
        _log_ops(f"DENY(no_key_config) {request.path} ip={request.remote_addr}")
        return False

    if not got:
        _log_ops(f"DENY(no_header) {request.path} ip={request.remote_addr} sources={[k['src'] for k in keys]}")
        return False

    for item in keys:
        if got == item["key"]:
            _log_ops(f"ALLOW {request.path} ip={request.remote_addr} via={item['src']}")
            return True

    _log_ops(f"DENY(bad_key) {request.path} ip={request.remote_addr} got_len={len(got)} sources={[k['src'] for k in keys]}")
    return False

def _port_open(port: int, host="127.0.0.1", timeout=0.4) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except:
        return False

def _proc_running(name_substr: str) -> bool:
    try:
        target = name_substr.lower()
        for proc in psutil.process_iter(["name", "cmdline"]):
            try:
                nm = (proc.info.get("name") or "").lower()
                cmd = " ".join(proc.info.get("cmdline") or []).lower()
                if target in nm or target in cmd:
                    return True
            except:
                continue
    except:
        pass
    return False

